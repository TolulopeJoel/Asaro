{
  "expo": {
    "name": "Àṣàrò",
    "slug": "asaro",
    "version": "2026.SEPTEMBER",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asaro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "WAKE_LOCK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "useNextNotificationsApi": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/foregroundImage.png",
        "backgroundImage": "./assets/images/backgroundImage.png",
        "monochromeImage": "./assets/images/monochrome.png",
        "backgroundColor": "#17263F"
      },
      "package": "com.asaro.meditation"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/foregroundImage.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#17263F"
        }
      ],
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notificationIcon.png",
          "color": "#C9762C",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Àṣàrò Reminder"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "./plugins/withOnnxruntimePackage",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/fraunces/700Bold/Fraunces_700Bold.ttf",
            "./node_modules/@expo-google-fonts/work-sans/400Regular/WorkSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/work-sans/600SemiBold/WorkSans_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "Practices",
              "label": "Àṣàrò practices",
              "description": "Tick today's practices from your home screen",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3eab02f1-b324-49fc-ae59-6d1bf4813176"
      }
    },
    "ios": {
      "bundleIdentifier": "com.asaro.meditation"
    }
  }
}
