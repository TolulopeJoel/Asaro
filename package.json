{
  "name": "meditationreminder",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:graph": "node scripts/build-bible-graph.mjs",
    "verify": "npm run verify:bible && npm run verify:observations && npm run verify:detectors && npm run verify:practice && npm run verify:cloth && npm run verify:echoes && npm run verify:ml",
    "verify:echoes": "node --disable-warning=ExperimentalWarning scripts/verify-echoes-tone.mjs",
    "verify:bible": "node scripts/verify-bible-graph.mjs",
    "verify:observations": "node --disable-warning=ExperimentalWarning scripts/verify-observations.mjs",
    "verify:detectors": "node scripts/verify-convergence.mjs && node scripts/verify-commitment.mjs && node --disable-warning=ExperimentalWarning scripts/verify-absence.mjs",
    "verify:ml": "node scripts/verify-tokenizer.mjs && node scripts/verify-theme-matching.mjs && node scripts/verify-theme-quality.mjs",
    "check:glyphs": "node scripts/check-glyphs.mjs",
    "check:design": "node scripts/check-design.mjs",
    "verify:practice": "node scripts/verify-practice.mjs",
    "verify:cloth": "node scripts/verify-cloth.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/work-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/auth": "^23.8.6",
    "@react-native-firebase/firestore": "^23.8.6",
    "expo": "^54.0.26",
    "expo-asset": "~12.0.13",
    "expo-battery": "~10.0.8",
    "expo-constants": "~18.0.10",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.9",
    "expo-intent-launcher": "~13.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.13",
    "expo-router": "~6.0.16",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.11",
    "expo-sqlite": "~16.0.9",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.9",
    "lucide-react-native": "^1.20.0",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-dev-client": "~6.0.20",
    "typescript": "~5.9.2"
  },
  "private": true
}
